{
  "openapi": "3.0.3",
  "info": {
    "title": "SafePermit API (Proposed)",
    "version": "1.0.0",
    "description": "Proposed backend contract; not implemented or deployed. Enforce all safety decisions server-side."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          }
        }
      },
      "Permit": {
        "type": "object",
        "required": [
          "id",
          "status",
          "workType",
          "siteId",
          "createdBy"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Draft",
              "Pending Supervisor Review",
              "Pending Safety Review",
              "Pending Admin Approval",
              "Approved",
              "Returned for Correction",
              "Rejected",
              "Stopped",
              "Closed"
            ]
          },
          "workType": {
            "type": "string"
          },
          "siteId": {
            "type": "string"
          },
          "areaId": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Decision": {
        "type": "object",
        "required": [
          "role",
          "decision"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "supervisor",
              "safety",
              "admin"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "return",
              "reject"
            ]
          },
          "comment": {
            "type": "string"
          }
        }
      },
      "SafetyReview": {
        "type": "object",
        "properties": {
          "permitId": {
            "type": "string"
          },
          "eligibleForApproval": {
            "type": "boolean"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Record": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "permitId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "paths": {
    "/permits": {
      "get": {
        "summary": "List permits visible to actor",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Permit"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "State/version conflict"
          },
          "422": {
            "description": "Safety constraints failed"
          }
        }
      },
      "post": {
        "summary": "Create permit",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Permit"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "State/version conflict"
          },
          "422": {
            "description": "Safety constraints failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Permit"
              }
            }
          }
        }
      }
    },
